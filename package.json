{
  "name": "fleetops-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:pull": "node scripts/pull-openapi.ts",
    "api:gen": "openapi-ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fsd": "steiger ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:fsd && npm run format:check && npm run test"
  },
  "dependencies": {
